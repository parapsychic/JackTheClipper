<Window x:Class="JackTheClipper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jack the Clipper" Icon="app.ico" Width="800" Height="800" MinWidth="320" MinHeight="240"
        ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15">
  <WindowChrome.WindowChrome>
    <!-- no title bar or frame, but keep edge resizing; the 1px glass edge buys the Windows drop shadow -->
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- Windows 11 subtle icon button -->
    <Style TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Windows 11 accent (primary) button -->
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
      <Setter Property="Padding" Value="12,6,16,7"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Bare text fields: no box, no focus underline -->
    <ControlTemplate x:Key="BareText" TargetType="TextBoxBase">
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"
                    HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
    </ControlTemplate>
    <Style x:Key="Bare" TargetType="TextBoxBase">
      <Setter Property="Template" Value="{StaticResource BareText}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Bare}"/>
    <Style TargetType="RichTextBox" BasedOn="{StaticResource Bare}"/>
  </Window.Resources>

  <Grid>
    <DockPanel x:Name="EditorView">
      <Grid DockPanel.Dock="Top" Margin="12,12,12,0" Background="Transparent" MouseLeftButtonDown="DragWindow">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Content="&#xE72B;" ToolTip="All notes" Click="Back"/>
        <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,8,0">
          <TextBlock x:Name="TitleHint" Text="Title" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False"/>
          <TextBox x:Name="TitleBox" FontSize="28" FontWeight="SemiBold" MinWidth="120"/>
        </Grid>
        <TextBlock x:Name="PinMark" Grid.Column="2" Text="&#xE718;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" ToolTip="Pinned"/>
        <Button x:Name="PubBtn" Grid.Column="3" Content="&#xE753;" Click="TogglePublic"/>
        <Button Grid.Column="4" ToolTip="More" Click="More">
          <TextBlock Text="&#xE712;"><TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform></TextBlock>
        </Button>
      </Grid>
      <Grid>
        <!-- body text lines up with the title, which sits right of the back button -->
        <TextBlock x:Name="BodyHint" Text="Start typing, or paste text or an image" FontSize="16" Margin="65,8,0,0"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False"/>
        <!-- built-in undo is off: it can't coexist with live Markdown styling, so the window keeps its own -->
        <RichTextBox x:Name="Editor" FontSize="16" Padding="61,8,40,24" AcceptsTab="True" VerticalScrollBarVisibility="Auto" IsUndoEnabled="False">
          <RichTextBox.Resources>
            <Style TargetType="Paragraph">
              <Setter Property="Margin" Value="0"/>
              <Setter Property="LineHeight" Value="26"/>
            </Style>
          </RichTextBox.Resources>
        </RichTextBox>
      </Grid>
    </DockPanel>

    <DockPanel x:Name="HistoryView" Visibility="Collapsed">
      <Grid DockPanel.Dock="Top" Margin="24,16,12,12" Background="Transparent" MouseLeftButtonDown="DragWindow">
        <StackPanel>
          <TextBlock Text="Jack the Clipper" FontSize="28" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <Ellipse x:Name="PeersDot" Width="8" Height="8" Margin="0,1,8,0" VerticalAlignment="Center" Fill="{DynamicResource TextFillColorTertiaryBrush}"/>
            <TextBlock x:Name="PeersText" Text="Looking for peers…" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </StackPanel>
        <Button x:Name="NewBtn" Style="{StaticResource AccentButton}" ToolTip="Ctrl+N" HorizontalAlignment="Right" Margin="0,0,12,0" Click="NewClick">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="New note"/>
          </StackPanel>
        </Button>
      </Grid>
      <Grid>
        <TextBlock x:Name="EmptyHint" Text="No notes yet" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <UniformGrid x:Name="Cards" Columns="3" Margin="18,0,18,18" VerticalAlignment="Top"/>
        </ScrollViewer>
      </Grid>
    </DockPanel>

    <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24" Padding="16,8" CornerRadius="16"
            Background="{DynamicResource TextFillColorPrimaryBrush}">
      <TextBlock x:Name="ToastText" FontSize="13" Foreground="{DynamicResource TextFillColorInverseBrush}"/>
    </Border>
  </Grid>
</Window>
